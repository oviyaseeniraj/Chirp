# acl = access control list, which defines security/access control for MQTT users
# essentially limits users to only be able to read/write from specific topics defined in this file
# acl filed is referenced in mosquitto.conf (mosquitto is the MQTT broker)

# laptop operator account
user laptop-control
topic write chirp/v1/server/start/request
topic read chirp/v1/server/start/result

# xavier controller account
user server-xavier
topic read chirp/v1/server/start/request
topic write chirp/v1/server/start/result
topic write chirp/v1/group/+/capture/start
topic write chirp/v1/group/+/capture/resync
topic read chirp/v1/group/+/capture/ack/+
topic read chirp/v1/group/+/capture/state/+
topic read chirp/v1/presence/+

# per-radar account pattern:
# create usernames that exactly match nodeId (for example, radar-orin-01)
pattern write chirp/v1/presence/%u
pattern write chirp/v1/group/+/capture/ack/%u
pattern write chirp/v1/group/+/capture/state/%u
pattern read chirp/v1/group/+/capture/start
pattern read chirp/v1/group/+/capture/resync
