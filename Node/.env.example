# Copy this file to Node/.env and fill real values (you need to create a .env file if it doesn't exist yet)
# Node/.env is ignored by git (in the .gitignore) and should never be committed

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DB_WRITE_ENABLED=true

# Protocol version lock for current server_controller.py contract.
CHIRP_SCHEMA_VERSION=1

# Broker endpoint shared by Jetson Xavier server and all Orin nodes.
MQTT_HOST=X.X.X.X # ip address of server node
MQTT_PORT=1883 # Mosquitto (MQTT broker) configured to listen on port 1883 by default

# Node credentials for MQTT auth (passwords should match broker-side setup).
MQTT_USERNAME=nodeX             # replace "X" with number of node; MQTT_USERNAME should match NODE_ID for clarity
MQTT_PASSWORD=chirp

# Per-node identity used by MQTT trigger client.
# NODE_ID should be unique per Orin and match broker ACL identity conventions.
NODE_ID=nodeX
GROUP_ID=default
MQTT_CLIENT_ID=radar-nodeX      # replace "X" with number of node