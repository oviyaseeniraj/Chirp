MQTT_LAPTOP_USER=laptop-control
MQTT_LAPTOP_PASS=change-me-laptop # change to password of operator's laptop

MQTT_SERVER_USER=server-xavier
MQTT_SERVER_PASS=change-me-server # change to password of the Jetson Xavier / server node

# Comma-separated node IDs; usernames should equal nodeId for ACL pattern usage.
MQTT_RADAR_NODE_IDS=radar-orin-01,radar-orin-02,radar-orin-03,radar-orin-04
MQTT_RADAR_PASSWORD=change-me-radar-shared # change to password of Jetson Orin Nano node