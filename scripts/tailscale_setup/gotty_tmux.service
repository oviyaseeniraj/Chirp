[Unit]
Description=gotty web terminal (tmux)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
User=chirp
Group=chirp
EnvironmentFile=/home/chirp/.gotty_env
WorkingDirectory=/home/chirp
ExecStart=/usr/local/bin/gotty --config /home/chirp/.gotty tmux new -A -s gotty top
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target