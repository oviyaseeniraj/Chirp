# Copy to Fusion-Center/.env and fill in real values (Fusion-Center/.env is gitignored).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DB_WRITE_ENABLED=true

CHIRP_SCHEMA_VERSION=1

# Broker endpoint (numeric IP avoids DNS; must not stay as X.X.X.X).
MQTT_HOST=X.X.X.X
MQTT_PORT=1883

# server_controller.py and tools on the Xavier use MQTT_USERNAME / MQTT_PASSWORD / MQTT_CLIENT_ID.
MQTT_USERNAME=server-xavier
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=server-xavier

# Optional metadata (Orins use these in Node/.env; safe to duplicate here for reference).
NODE_ID=node4
GROUP_ID=default

# --- Mosquitto password file generation (Fusion-Center/MQTT-Broker/set_mqttbroker_passwords.sh) ---
MQTT_LAPTOP_USER=laptop-control
MQTT_LAPTOP_PASS=change-me
MQTT_SERVER_USER=server-xavier
MQTT_SERVER_PASS=change-me
MQTT_RADAR_NODE_IDS=node1,node2,node3,node4
MQTT_RADAR_PASSWORD=change-me
