[Unit]
Description=Chirp Node Launcher
Documentation=https://github.com/your-org/chirp
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
Type=simple
User=root
Group=root
Environment=NODE_DIR=/home/chirp/Chirp/Node
Environment=HOME=/home/chirp
WorkingDirectory=/home/chirp/Chirp/Node
ExecStart=/home/chirp/Chirp/Node/.venv/bin/python3 /home/chirp/Chirp/Node/src/node_launcher.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chirp-launcher

# Security hardening (optional — tighten as needed)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp /home/chirp/Chirp/Node/logs /home/chirp/Chirp/Node/src /home/chirp/Chirp/Node/scripts /home/chirp/Chirp/Node/setup_radar /home/chirp/Chirp/Node/DCA1000
ReadOnlyPaths=/home/chirp/Chirp/Node/.env

[Install]
WantedBy=multi-user.target
