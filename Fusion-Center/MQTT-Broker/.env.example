# Broker endpoint shared by Jetson Xavier server and all Orin nodes.
MQTT_HOST=X.X.X.X # ip address of server node
MQTT_PORT=1883    # Mosquitto (MQTT broker) configured to listen on port 1883 by default

MQTT_LAPTOP_USER=chirp
MQTT_LAPTOP_PASS=chirp

MQTT_SERVER_USER=chirp
MQTT_SERVER_PASS=chirp

# Comma-separated node IDs; usernames should equal nodeId for ACL pattern usage.
MQTT_RADAR_NODE_IDS=node1,node2,node3,node4
MQTT_RADAR_PASSWORD=change-me-radar-shared # change to password of Jetson Orin Nano node